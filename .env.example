# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub + Supabase (dashboard links / future DB)
NEXT_PUBLIC_GITHUB_REPO=https://github.com/passawutaplus/blacksmithtools
NEXT_PUBLIC_SUPABASE_URL=https://zkflkpbmbozrchqncpzi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set true only after Payso merchant KYB approved
PAYMENTS_LIVE=false

# Optional email for cash receipts
# RESEND_API_KEY=
# EMAIL_FROM=noreply@blacksmithstores.com

# อ่านแคปหน้าออเดอร์ Shopee ตอนพิมพ์บิล (อย่างน้อยหนึ่งคีย์)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# เก็บออเดอร์/บิล/สลิปถาวรบน Vercel (local ใช้ data/runtime/)
# BLOB_READ_WRITE_TOKEN=
# Admin gate: required in production (backoffice stays locked if unset)
ADMIN_PASSWORD=

# Payso Web API v2 (controls.paysolutions.asia > Merchant Settings > Merchant Details > Parameter Key)
# PAYSO_MERCHANT_ID=12345678
# PAYSO_API_KEY=
# PAYSO_SECRET_KEY=
# PAYSO_TERMINAL_ID=
# PAYSO_KEY_VERSION=1

# แจ้งเตือนร้านทาง LINE (Messaging API ของ LINE OA)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_NOTIFY_TO=Uxxxxxxxx,Cxxxxxxxx  (ส่ง "รหัสแจ้งเตือน" หา OA เพื่อรับรหัส · webhook: /api/line/webhook)
